map $uri $forge_cache_control {
    default                                      "no-store";
    /styles.css                                  "no-cache";
    ~^/dist/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\.js$ "no-cache";
}

log_format forge_static '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen __FORGE_HTTP_PORT__;
    listen [::]:__FORGE_HTTP_PORT__;
    server_name __FORGE_SERVER_NAME__;
    access_log /var/log/nginx/access.log forge_static;
    error_log /var/log/nginx/error.log warn;
    return 308 __FORGE_PUBLIC_ORIGIN__$request_uri;
}

server {
    listen __FORGE_HTTPS_PORT__ ssl;
    listen [::]:__FORGE_HTTPS_PORT__ ssl;
    server_name __FORGE_SERVER_NAME__;

    root __FORGE_RELEASE_ROOT__;
    index index.html;
    autoindex off;
    server_tokens off;
    access_log /var/log/nginx/access.log forge_static;
    error_log /var/log/nginx/error.log warn;

    ssl_certificate __FORGE_TLS_CERTIFICATE__;
    ssl_certificate_key __FORGE_TLS_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; manifest-src 'none'; worker-src 'none'; upgrade-insecure-requests" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cache-Control $forge_cache_control always;

    etag on;

    location = / { try_files /index.html =404; }
    location = /index.html { try_files /index.html =404; }
    location = /generators/nginx { try_files /index.html =404; }
    location = /generators/compose { try_files /index.html =404; }
    location = /generators/systemd { try_files /index.html =404; }
    location = /styles.css { try_files /styles.css =404; }

    location ~ ^/dist/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\.js$ {
        try_files $uri =404;
    }

    location ~ (^|/)\. { return 404; }
    location ~* \.(?:ts|tsx|map|md|json|lock|ya?ml|env|pem|key|crt|conf|service|sh|ps1)$ { return 404; }
    location ~* ^/(?:src|tests?|docs?|scripts?|ops|node_modules|\.git)(?:/|$) { return 404; }
    location / { return 404; }
}
