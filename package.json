{
  "name": "forge-config-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node server.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:ui": "npm run build && playwright test",
    "test:native:nginx": "npm run build && node tests/nginx-native-harness.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "5.9.3"
  }
}
